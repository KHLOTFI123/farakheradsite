DATABASE_URL=sqlite:///./data/farakherad.db
# Use a long random value in production (32+ chars). Example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Set true only when you intentionally want startup to reset the admin password hash
RESET_ADMIN_PASSWORD=false
ACCESS_TOKEN_EXPIRE_MINUTES=480
SITE_URL=https://farakheradgroup.ir
# development | production  (production disables /docs and enforces strong secrets)
ENVIRONMENT=development
# Optional comma-separated browser origins; defaults to SITE_URL + local Vite/Docker
# CORS_ORIGINS=https://farakheradgroup.ir,https://www.farakheradgroup.ir
MAX_UPLOAD_BYTES=5242880
LOGIN_RATE_LIMIT=10
CONTACT_RATE_LIMIT=8
